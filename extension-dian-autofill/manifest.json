{
  "manifest_version": 3,
  "name": "Asistente DIAN Autollenado + Desbloqueo PDF — Conciliador TributoApp",
  "version": "2.2.0",
  "description": "Rellena CUFE y NIT sin DV en la DIAN y descarga el PDF YA DESBLOQUEADO con Prefijo y Número de Factura (ej. FE-29159.pdf).",
  "permissions": ["downloads", "storage"],
  "host_permissions": [
    "https://catalogo-vpfe.dian.gov.co/*",
    "https://*.dian.gov.co/*",
    "https://*.blob.core.windows.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://catalogo-vpfe.dian.gov.co/*",
        "https://*.dian.gov.co/*"
      ],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://catalogo-vpfe.dian.gov.co/*",
        "https://*.dian.gov.co/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
